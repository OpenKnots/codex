{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Remote",
  "version": "0.1.0",
  "identifier": "com.openai.codex.remote",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "height": 932,
        "label": "main",
        "resizable": true,
        "title": "Codex Remote",
        "width": 430
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "app-icon.png"
    ],
    "targets": "all"
  }
}
